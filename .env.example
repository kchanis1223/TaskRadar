OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=45

# Optional subscription OAuth provider via opencode + opencode-claude-auth.
# On Linux servers, use XDG_CONFIG_HOME with deploy/opencode-taskradar.json.
# TASKRADAR_USE_OPENCODE=1
# TASKRADAR_REQUIRE_OPENCODE=1
# TASKRADAR_OPENCODE_COMMAND=opencode
# TASKRADAR_OPENCODE_MODEL=anthropic/claude-haiku-4-5
# TASKRADAR_OPENCODE_TIMEOUT=180
# TASKRADAR_OPENCODE_WORK_DIR=C:\Temp\taskradar-opencode-work
# TASKRADAR_OPENCODE_CONFIG_HOME=/home/ubuntu/.config/taskradar

# Optional access password for a public local-server demo.
# TASKRADAR_ACCESS_PASSWORD=change-this-password

# Optional alternative provider.
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_TIMEOUT=45

# GEMMA_API_URL=http://localhost:8000/analyze
